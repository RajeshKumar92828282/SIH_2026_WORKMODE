generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// CORE MARKET TABLES (Populated by Worker Engine — Introspected from Live DB)
// -----------------------------------------------------------------------------

model StaticFare {
  id            Int      @id @default(autoincrement())
  carrier       String   @db.VarChar(100)
  flightNumber  String   @map("flight_number") @db.VarChar(30)
  flightDate    DateTime @map("flight_date") @db.Date
  origin        String   @db.VarChar(10)
  destination   String   @db.VarChar(10)
  flightTime    String   @map("flight_time") @db.VarChar(30)
  cabinClass    String   @map("cabin_class") @db.VarChar(30)
  advanceWindow String?  @map("advance_window") @db.VarChar(20)
  baseFare      Float?   @map("base_fare")
  taxes         Float?   @map("taxes")
  totalFare     Float    @map("total_fare")
  observedAt    DateTime @map("observed_at") @db.Timestamp(6)

  @@map("static_fares")
}

model LiveFare {
  id            Int      @id @default(autoincrement())
  carrier       String
  flightNumber  String   @map("flight_number")
  flightDate    DateTime @map("flight_date") @db.Date
  origin        String
  destination   String
  flightTime    String   @map("flight_time")
  cabinClass    String   @map("cabin_class")
  advanceWindow String?  @map("advance_window")
  baseFare      Float?   @map("base_fare")
  taxes         Float?   @map("taxes")
  totalFare     Float    @map("total_fare")
  observedAt    DateTime @map("observed_at")

  @@map("live_fares")
}

model IndexResult {
  id            Int      @id @default(autoincrement())
  origin        String
  destination   String
  advanceWindow String?  @map("advance_window")
  cabinClass    String?  @map("cabin_class")
  indexValue    Float    @map("index_value")
  observedAt    DateTime @map("observed_at")
  runId         String   @map("run_id")

  @@index([runId], map: "ix_index_results_run_id")
  @@index([observedAt])
  @@index([origin, destination])
  @@map("index_results")
}

// -----------------------------------------------------------------------------
// SUPPORTING & GOVERNANCE TABLES (Owned by Backend API)
// -----------------------------------------------------------------------------

model Route {
  id          String   @id // e.g., "DEL-BOM"
  origin      String
  destination String
  weight      Float    // DGCA passenger traffic share (sums to 1.0)
  createdAt   DateTime @default(now()) @map("created_at")

  alerts      Alert[]

  @@map("routes")
}

model Carrier {
  id        String   @id // e.g., "IGO", "SEJ", "AIC", "VTI"
  name      String   // "IndiGo", "SpiceJet", "Air India", "Vistara"
  code      String   // "6E", "SG", "AI", "UK"
  createdAt DateTime @default(now()) @map("created_at")

  @@map("carriers")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         String   @default("analyst") // "admin", "analyst"
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("users")
}

model Organization {
  id           String   @id @default(cuid())
  name         String
  type         String   // "rbi", "nso", "researcher", "govt_agency"
  contactEmail String?  @map("contact_email")
  createdAt    DateTime @default(now()) @map("created_at")

  apiKeys      ApiKey[]

  @@map("organizations")
}

model ApiKey {
  id           String       @id @default(cuid())
  orgId        String       @map("org_id")
  keyHash      String       @unique @map("key_hash")
  keyMask      String       @map("key_mask") // e.g. apix_live_...a8f2
  scope        String       @default("read:index")
  rateTier     String       @default("standard") @map("rate_tier")
  createdAt    DateTime     @default(now()) @map("created_at")
  revokedAt    DateTime?    @map("revoked_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@map("api_keys")
}

model Alert {
  id        Int      @id @default(autoincrement())
  type      String   // FARE_SPIKE, DATA_QUALITY
  routeId   String?  @map("route_id")
  message   String
  createdAt DateTime @default(now()) @map("created_at")

  route     Route?   @relation(fields: [routeId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@map("alerts")
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  actor     String
  action    String
  target    String
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("audit_logs")
}
